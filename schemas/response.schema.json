{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TBP-001 response",
  "type": "object",
  "required": [
    "protocol",
    "experiment_id",
    "responding_agent",
    "started_at",
    "executed_at",
    "discovered_beacon",
    "freshness_proof",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "TBP-001/v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^(?:TBP-001-(?:DEV|DRYRUN|LIVE)-[0-9]{3})$"
    },
    "responding_agent": {
      "const": "AGENT-B"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "discovered_beacon": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "hash",
        "challenge_nonce"
      ],
      "additionalProperties": false,
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "hash": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$"
        },
        "challenge_nonce": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$"
        }
      }
    },
    "freshness_proof": {
      "type": "object",
      "required": [
        "source",
        "event_id",
        "source_timestamp",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.:-]{1,128})$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.:-]{1,128})$"
        },
        "source_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "value": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{128})$"
        }
      }
    },
    "status": {
      "const": "HANDSHAKE_COMPLETE"
    }
  }
}
