{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TBP-001 beacon",
  "type": "object",
  "required": [
    "protocol",
    "experiment_id",
    "created_at",
    "origin_agent",
    "challenge_nonce",
    "instructions",
    "discovery_context",
    "response_schema_version",
    "hash_algorithm"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "TBP-001/v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^(?:TBP-001-(?:DEV|DRYRUN|LIVE)-[0-9]{3})$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "origin_agent": {
      "const": "AGENT-A"
    },
    "challenge_nonce": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{64})$"
    },
    "instructions": {
      "const": {
        "discover": true,
        "verify": true,
        "obtain_freshness_proof": true,
        "publish_response": true
      }
    },
    "discovery_context": {
      "const": "TBP-001 rendezvous"
    },
    "response_schema_version": {
      "const": "1"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    }
  }
}
